# Supabase — copie para .env e preencha com os dados do seu projeto
# Dashboard: https://supabase.com/dashboard → seu projeto → Settings → API
VITE_SUPABASE_URL=https://SEU_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=sua_anon_key_aqui

# Após configurar as variáveis, execute no Supabase (SQL Editor) o arquivo:
# supabase/migrations/20260319210000_settings_schedules.sql
# (tabelas settings + schedules e RLS). Ver supabase/README.md.

# Assistente IA em consultas (opcional) — chave da API OpenAI
# https://platform.openai.com/api-keys
# VITE_OPENAI_API_KEY=sk-...
